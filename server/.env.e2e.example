# Environment for the Playwright test stack (see playwright.config.ts).
# Copy to .env.e2e. The database name MUST end in _test; e2e/scripts/reset-db.ts
# drops and recreates it on every run.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk_test?schema=public"
BETTER_AUTH_SECRET=e2e-only-secret-not-used-anywhere-else-0123456789
BETTER_AUTH_URL=http://localhost:3001
CLIENT_URL=http://localhost:5174

# Test admin created by the reset script
ADMIN_EMAIL=admin@e2e.test
ADMIN_PASSWORD=e2e-admin-password-123

# Secret for POST /api/inbound/email (min 32 chars)
INBOUND_SECRET=e2e-inbound-secret-0123456789abcdef0123
